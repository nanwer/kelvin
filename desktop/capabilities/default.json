{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Kelvin window may ask the desktop shell to do.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/nanwer/kelvin/*" }]
    }
  ]
}
