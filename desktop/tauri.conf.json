{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelvin",
  "version": "0.7.0",
  "identifier": "dev.kelvin.desktop",
  "build": {
    "frontendDist": "../src/Kelvin.Service/wwwroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kelvin",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5577 ws://127.0.0.1:5577; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1RjRDMTg5RTFGOUUxRUEKUldUcTRmbmhpY0gwSlN1RWxsV1FhaHQvbmRiQ09PYjVmVGpCNVA2S2hmMmJFckx1ODRCYm92VlgK",
      "endpoints": ["https://github.com/nanwer/kelvin/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Kelvin contributors",
    "shortDescription": "Fans and RGB lighting in one app",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "service-dist/": "service/",
      "deps/openrgb/": "openrgb/",
      "installer/install-pawnio.ps1": "scripts/install-pawnio.ps1",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
